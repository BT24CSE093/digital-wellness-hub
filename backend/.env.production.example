# Digital Wellness Hub - Production Deployment Environment Template
# Copy this file to .env on your backend hosting provider (e.g., Render)

NODE_ENV=production
PORT=5000

# PostgreSQL Connection String (e.g. from Render PostgreSQL, Supabase, Neon)
# e.g.: postgresql://dwh_admin:secure_password@dpg-xxxxxx.oregon-postgres.render.com/digital_wellness_hub?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Frontend URL (e.g., your Vercel production domain)
FRONTEND_URL=https://digital-wellness-hub.vercel.app

# Cryptographic Secrets (Minimum 32 random characters; generate via `openssl rand -base64 32`)
JWT_ACCESS_SECRET=replace_with_a_secure_random_32_char_access_secret_for_production
JWT_REFRESH_SECRET=replace_with_a_secure_random_32_char_refresh_secret_for_production

# Token Lifespans
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
