# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://dwh_user:dwh_password@localhost:5432/digital_wellness_hub?schema=public

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Security Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_placeholder
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_placeholder
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
