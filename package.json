{
  "name": "digital-wellness-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Wellness Hub — Your Digital Life. Your Rules. Full-stack platform for university students.",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:backend && npm run build:frontend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "prisma:seed": "npm run prisma:seed --prefix backend",
    "docker:db:up": "docker compose up -d",
    "docker:db:down": "docker compose down"
  },
  "keywords": [
    "digital-wellness",
    "react",
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "tailwind"
  ],
  "author": "Digital Wellness Hub Team",
  "license": "UNLICENSED"
}
